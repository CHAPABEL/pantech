# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8080

# Порт Docker web (как раньше: 5173:5173). Глобальный nginx → 127.0.0.1:5173
WEB_PUBLISH_PORT=5173

# SMTP (Reg.ru)
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_USER=info@pan-tech.ru
SMTP_PASS=
RECIPIENT_EMAIL=info@pan-tech.ru

# На сервере добавьте прод-домен: https://pan-tech.ru
FRONTEND_ORIGIN=http://localhost,http://localhost:5173,https://pan-tech.ru

# PostgreSQL
POSTGRES_CONTAINER_NAME=pantech_postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pantech_db
POSTGRES_PORT=5432
# Полный URL для backend (пароль со спецсимволами — URL-encode!)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pantech_db

# Admin auth
# Use ADMIN_PASSWORD (plain) for the simple path, or ADMIN_PASSWORD_HASH (bcrypt)
# for a safer setup. If both are set, the hash wins.
# Generate a hash with:  docker compose exec backend python -m scripts.hash_password
ADMIN_LOGIN=admin
ADMIN_PASSWORD=changeme
ADMIN_PASSWORD_HASH=

# JWT
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me
JWT_TTL_HOURS=12

# Cookie security (set to true behind HTTPS)
COOKIE_SECURE=false

# Auto-run seeds/initial.py on container start (1/0)
RUN_SEED=1
