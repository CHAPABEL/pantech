# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8080

# Порт на хосте для контейнера web (127.0.0.1:PORT → nginx:80 внутри).
# НЕ ставьте 80, если на сервере уже работает системный nginx!
WEB_PUBLISH_PORT=5173

# SMTP (Reg.ru)
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_USER=info@pan-tech.ru
SMTP_PASS=
RECIPIENT_EMAIL=info@pan-tech.ru

# Frontend / CORS (comma-separated list of origins)
# На сервере добавьте прод-домен: https://pan-tech.ru
FRONTEND_ORIGIN=http://localhost,http://localhost:5173

# PostgreSQL
POSTGRES_CONTAINER_NAME=pantech_postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pantech_db
POSTGRES_PORT=5432
# DATABASE_URL is built automatically from POSTGRES_* in docker-compose.yml.

# Admin auth
# Use ADMIN_PASSWORD (plain) for the simple path, or ADMIN_PASSWORD_HASH (bcrypt)
# for a safer setup. If both are set, the hash wins.
# Generate a hash with:  docker compose exec backend python -m scripts.hash_password
ADMIN_LOGIN=admin
ADMIN_PASSWORD=changeme
ADMIN_PASSWORD_HASH=

# JWT
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me
JWT_TTL_HOURS=12

# Cookie security (set to true behind HTTPS)
COOKIE_SECURE=false

# Auto-run seeds/initial.py on container start (1/0)
RUN_SEED=1
